# Vite names everything in /assets/ by content hash, so a file there never changes.
# The default (max-age=0, must-revalidate) made every page load re-check each one.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Markdown would come as text/markdown, which some phones download instead of show.
/THIRD_PARTY.md
  Content-Type: text/plain; charset=utf-8
