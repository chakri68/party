{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party-games",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Cloudflare creates the DNS record and certificate for this itself.
  "routes": [{ "pattern": "party-games.chakri.me", "custom_domain": true }],
  // One canonical URL: the custom domain. (Owner keys are per-origin anyway.)
  "workers_dev": false,
  "preview_urls": false,
  // The built web app. API and room sockets hit the worker; everything else is
  // static, with unknown paths falling back to index.html for /room/:code.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  // Dev-only debug messages (§41). `pnpm dev` passes --var DEV_TOOLS:1; deploys never do.
  "vars": { "DEV_TOOLS": "0" },
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
