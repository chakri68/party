{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couchparty",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "couchpartygames.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../product-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/parties/*", "/room/*", "/play", "/blind-rally/godot/*", "/treasure-hunt/godot/*"]
  },
  // Secrets (wrangler secret put): RESEND_API_KEY, GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET, ADMIN_KEY.
  "vars": {
    "DEV_TOOLS": "0",
    "BLIND_RALLY": "1",
    "TREASURE_HUNT": "1",
    "APP_ORIGIN": "https://couchpartygames.com",
    "TURNSTILE_SITE_KEY": "<set at setup>",
    "GOOGLE_CLIENT_ID": "<set at setup>"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "couchparty", "database_id": "<from wrangler d1 create>", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BLIND_RALLY_GODOT", "bucket_name": "couchparty-godot" }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
