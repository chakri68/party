{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couchparty",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "couchpartygames.com", "custom_domain": true }],
  "workers_dev": false,
  // Hourly: prune old sign-in links, room records and expired sessions (src/prune.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "preview_urls": false,
  "assets": {
    "directory": "../product-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/parties/*", "/room/*", "/blind-rally/godot/*", "/treasure-hunt/godot/*"]
  },
  // Secrets (wrangler secret put): RESEND_API_KEY, GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET, ADMIN_KEY, IP_HASH_KEY,
  // and, once BILLING is "1": RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, PADDLE_API_KEY, PADDLE_WEBHOOK_SECRET.
  // scripts/deploy-product.mjs reads BILLING from here to decide which secrets to demand.
  "vars": {
    "DEV_TOOLS": "0",
    "BLIND_RALLY": "1",
    "TREASURE_HUNT": "1",
    "BILLING": "0",
    "RAZORPAY_KEY_ID": "<set at setup>",
    "PADDLE_ENV": "sandbox",
    "PADDLE_CLIENT_TOKEN": "<set at setup>",
    "PADDLE_PRICE_MONTH": "<set at setup>",
    "PADDLE_PRICE_YEAR": "<set at setup>",
    "APP_ORIGIN": "https://couchpartygames.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF-FEgF2zeol-dh5",
    "GOOGLE_CLIENT_ID": "457178137263-akfeq9bds8qhpvjcip8vaa7n1hnhpm6c.apps.googleusercontent.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "couchparty", "database_id": "16a56246-c8d0-4ed3-a571-8997915e0e00", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BLIND_RALLY_GODOT", "bucket_name": "couchparty-godot" }],
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "EMAIL_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
