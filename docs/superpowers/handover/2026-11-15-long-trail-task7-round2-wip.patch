@@ -0,0 +1,65 @@
+// SCRATCH: parameter sweep for Task 7 tuning. Delete before commit.
+import { readFileSync, writeFileSync } from "node:fs";
+import { it } from "vitest";
+import { N } from "../shared/numbers.ts";
+import { tradeRoute } from "../shared/packs/trade-route.ts";
+import { play, run, TRACE_HOOK } from "./balance.test.ts";
+import type { Length } from "../shared/types.ts";
+
+type Any = Record<string, any>;
+function merge(dst: Any, src: Any) {
+  for (const [k, v] of Object.entries(src)) {
+    if (v && typeof v === "object" && !Array.isArray(v) && dst[k] && typeof dst[k] === "object") merge(dst[k], v);
+    else dst[k] = v;
+  }
+}
+
+it.runIf(!!process.env.SWEEP)("sweep", () => {
+  const configs: Any[] = JSON.parse(readFileSync(process.env.SWEEP!, "utf8"));
+  const baseN = structuredClone(N);
+  const baseStart = tradeRoute.start;
+  const baseRoutes = structuredClone(tradeRoute.routes);
+  const baseCap = tradeRoute.capacityPerAnimal;
+  const lines: string[] = [];
+  for (const cfg of configs) {
+    merge(N as Any, structuredClone(baseN));
+    tradeRoute.start = baseStart;
+    tradeRoute.routes = structuredClone(baseRoutes);
+    tradeRoute.capacityPerAnimal = cfg.cap ?? baseCap;
+    if (cfg.N) merge(N as Any, cfg.N);
+    if (cfg.start) {
+      const s = cfg.start;
+      tradeRoute.start = (n: number) => ({ ...baseStart(n), food: s.food * n, water: s.water * n, coins: s.coins, ...(s.cargo ? { cargo: { ...s.cargo } } : {}) });
+    }
+    if (cfg.markets)
+      for (const r of Object.values(tradeRoute.routes))
+        for (const st of r.stops) if (st.market && cfg.markets[st.id]) merge(st.market as Any, structuredClone(cfg.markets[st.id]));
+    if (cfg.legs)
+      for (const [len, legs] of Object.entries(cfg.legs as Record<string, Record<string, number>>))
+        for (const [key, km] of Object.entries(legs)) {
+          const [a, b] = key.split(">");
+          tradeRoute.routes[len as Length].stops.find((s) => s.id === a)!.next.find((l) => l.to === b)!.km = km;
+        }
+    const mir = tradeRoute.routes.short.stops.find((s) => s.id === "mirren-gate")!.market!.goods;
+    const st = tradeRoute.start(5);
+    const w0 = st.coins + Object.entries(st.cargo).reduce((a, [g, n]) => a + n * ((mir[g]![0] + mir[g]![1]) / 2), 0);
+    const [f, r, l] = cfg.gradeMul ?? [1.03, 1.5, 2.2];
+    tradeRoute.grades = { broke: 0, fair: Math.round(w0 * f), rich: Math.round(w0 * r), legendary: Math.round(w0 * l) };
+    TRACE_HOOK.on = !!cfg.trace;
+    TRACE_HOOK.lines = [];
+    const games = cfg.games ?? 150;
+    lines.push(`== ${cfg.name} W0=${w0} grades=${JSON.stringify(tradeRoute.grades)}`);
+    for (const len of (cfg.lengths ?? ["short", "normal", "epic"]) as Length[])
+      for (const p of (cfg.players ?? [5]) as number[])
+        for (const bot of cfg.bots ?? ["sensible", "no-trade", "careless"]) {
+          const r = run(bot, len, p, games);
+          if (cfg.pct && bot === "sensible") {
+            const ws = Array.from({ length: games }, (_, i) => play(bot, len, p, 1000 + i)).filter((x) => x.arrived).map((x) => x.wealth).sort((a, b) => a - b);
+            lines.push(`   wealth/W0 p10..p95: ${[0.1, 0.25, 0.5, 0.75, 0.9, 0.95].map((q) => (ws[Math.floor(q * (ws.length - 1))]! / w0).toFixed(2)).join(" ")}`);
+          }
+          lines.push(`${len.padEnd(6)} p${p} ${bot.padEnd(8)} arr ${r.arrive.toFixed(2)} dead ${r.dead.toFixed(2)} | b ${r.broke.toFixed(2)} f ${r.fair.toFixed(2)} r ${r.rich.toFixed(2)} L ${r.legendary.toFixed(2)} up ${r.fairUp.toFixed(2)} sold ${r.sold.toFixed(2)} | day ${r.medianDay}/${r.deadline} | w ${r.wealth}`);
+        }
+  }
+  if (TRACE_HOOK.lines.length) writeFileSync(process.env.SWEEP_OUT! + ".trace", TRACE_HOOK.lines.join("\n"));
+  writeFileSync(process.env.SWEEP_OUT!, lines.join("\n") + "\n");
+}, 900_000);
